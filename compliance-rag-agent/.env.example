# ==============================================================================
# Engineering Compliance RAG System - Environment Configuration
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=change-me-in-production-compliance-rag-secret-key-99923
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# CORS Configuration for React Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# Dev uses SQLite by default. Set DATABASE_URL to use PostgreSQL in production.
# DATABASE_URL=postgres://compliance_user:compliance_pass@postgres:5432/compliance_rag
DB_SQLITE_PATH=/app/db_data/db.sqlite3

# ChromaDB Persistent Storage Configuration
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION_NAME=engineering_compliance_standards

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
